PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swiftorbits
JWT_SECRET=swiftorbits_super_secure_jwt_secret_key_2026
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
ADMIN_EMAIL=admin@swiftorbits.us
ADMIN_PASSWORD=admin123456
NODE_ENV=development

# SMTP / Email Service Configuration (SwiftOrbits Verification Engine)
# FASTEST OPTION: Gmail (Receives in client email within 2-5 seconds)
# To use Gmail:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Go to 'App passwords' -> Generate a 16-character App Password
# 3. Set SMTP_SERVICE=gmail, SMTP_USER=your_email@gmail.com, SMTP_PASS=your_16_char_password
# SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@swiftorbits.com
SMTP_PASS=
SMTP_FROM="SwiftOrbits" <info@swiftorbits.com>

